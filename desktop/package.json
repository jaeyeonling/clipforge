{
  "name": "clipforge-desktop",
  "productName": "clipforge",
  "version": "0.2.0",
  "description": "clipforge 데스크톱 껍데기 (Electron): Python 엔진을 사이드카로 띄우고 React 화면을 창에 담는다. 트레이 상주, 작업 알림.",
  "main": "main.js",
  "private": true,
  "author": "clipforge",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.1.5"
  },
  "dependencies": {
    "ws": "^8.18.1"
  },
  "build": {
    "appId": "kr.clipforge.app",
    "productName": "clipforge",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "engine.js", "assets/**"],
    "extraResources": [
      { "from": "../app/dist", "to": "ui" },
      { "from": "../engine-dist", "to": "engine", "filter": ["**/*"] }
    ],
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
