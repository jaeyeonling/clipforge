{
  "name": "clipforge-desktop",
  "productName": "clipforge",
  "version": "0.2.0",
  "description": "clipforge 데스크톱 껍데기 (Electron): Python 엔진을 사이드카로 띄우고 React 화면을 창에 담는다. 트레이 상주, 작업 알림.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaeyeonling/clipforge.git",
    "directory": "desktop"
  },
  "main": "main.js",
  "private": true,
  "author": "jaeyeonling",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "pack": "electron-builder --win --dir --config electron-builder.config.js --publish never",
    "dist": "electron-builder --win nsis --config electron-builder.config.js --publish never",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.1"
  }
}
